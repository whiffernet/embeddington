# embeddington MCP server config.
#
# Copy to .env in this directory and fill in your values:
#   cp .env.example .env
#
# server.py loads this file at startup via python-dotenv. Process env vars
# (e.g. from claude_desktop_config.json or .mcp.json) override these values.
#
# DO NOT commit .env. It is gitignored at the package level.

# --- Service endpoints ----------------------------------------------------
QDRANT_URL=http://localhost:6333

# Only needed if your Qdrant requires authentication — Qdrant Cloud, or a
# self-hosted instance with `service.api_key` set. Leave this commented out for
# the local Qdrant started by consumer/docker-compose.yml, which has no key.
# QDRANT_API_KEY=
ARANGO_URL=http://localhost:8529
EMBED_URL=http://localhost:8100/embed

# --- Fatal startup probes (optional) --------------------------------------
# The server refuses to start unless Qdrant can serve its collection AND the
# /embed endpoint answers with correctly-sized vectors. Both are required by
# every vector query, so booting without them would only defer the failure to
# each individual call. Arango is NOT fatal: without it, enrich still returns
# vector results, so its probe warns and the KG tools report their own error.
#
# The probes retry transport failures only — a host that is down or still
# starting — so a brief restart does not take the server down with it. A 401,
# a missing collection, a wrong embedding dimension or a malformed URL all
# still fail immediately.
#
# Defaults are fine for a local Compose stack. Raise the deadline for a slow
# remote host, or set EMBEDDINGTON_STARTUP_RETRIES=0 to restore fail-on-first-
# attempt. The probes run concurrently and total retry time is capped by the
# deadline, so startup cannot outlast the MCP client's own init timeout.
# EMBEDDINGTON_STARTUP_RETRIES=3
# EMBEDDINGTON_STARTUP_RETRY_BACKOFF=2
# EMBEDDINGTON_STARTUP_PROBE_TIMEOUT=5
# EMBEDDINGTON_STARTUP_DEADLINE=15

# --- Arango credentials ---------------------------------------------------
# This is YOUR local ArangoDB, started by consumer/docker-compose.yml with the
# password you set in consumer/.env. `root` here is your own container's root;
# no shared credential ships with this repo.
ARANGO_DATABASE=technology_kg
ARANGO_USER=root
ARANGO_PASSWORD=
