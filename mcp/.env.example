# embeddington MCP server config.
#
# Copy to .env in this directory and fill in your values:
#   cp .env.example .env
#
# server.py loads this file at startup via python-dotenv. Process env vars
# (e.g. from claude_desktop_config.json or .mcp.json) override these values.
#
# DO NOT commit .env. It is gitignored at the package level.

# --- Service endpoints ----------------------------------------------------
QDRANT_URL=http://localhost:6333

# Only needed if your Qdrant requires authentication — Qdrant Cloud, or a
# self-hosted instance with `service.api_key` set. Leave this commented out for
# the local Qdrant started by consumer/docker-compose.yml, which has no key.
# QDRANT_API_KEY=
ARANGO_URL=http://localhost:8529
EMBED_URL=http://localhost:8100/embed

# --- Startup Qdrant probe (optional) --------------------------------------
# The server refuses to start if Qdrant cannot serve its collection. The probe
# retries transport failures only — a host that is down or still starting —
# so a brief restart does not take the server down with it. A 401, a missing
# collection or a malformed QDRANT_URL still fails immediately.
#
# Defaults are fine for a local Compose stack. Raise the deadline for a slow
# remote host, or set EMBEDDINGTON_QDRANT_STARTUP_RETRIES=0 to restore the
# original fail-immediately behaviour. Total retry time is capped by the
# deadline, so startup cannot outlast the MCP client's own init timeout.
# EMBEDDINGTON_QDRANT_STARTUP_RETRIES=3
# EMBEDDINGTON_QDRANT_STARTUP_RETRY_BACKOFF=2
# EMBEDDINGTON_QDRANT_STARTUP_PROBE_TIMEOUT=5
# EMBEDDINGTON_QDRANT_STARTUP_DEADLINE=15

# --- Arango credentials ---------------------------------------------------
# This is YOUR local ArangoDB, started by consumer/docker-compose.yml with the
# password you set in consumer/.env. `root` here is your own container's root;
# no shared credential ships with this repo.
ARANGO_DATABASE=technology_kg
ARANGO_USER=root
ARANGO_PASSWORD=
