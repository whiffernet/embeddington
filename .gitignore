__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
build/
dist/
data/
.env
*.env
.env.*
# .env.* would swallow future config templates; tracked ones only survive
# because tracking overrides ignore. Keep templates addable:
!.env.example
!*.env.example
.superpowers/
.coverage
# Claude Code: the repo SHIPS .claude/commands/ (slash commands for the MCP tools), but a
# working clone also grows .claude/worktrees/ locally. Ignore that one directory so a
# `git add .claude` can never sweep an entire worktree into the repo.
.claude/worktrees/

install.log
